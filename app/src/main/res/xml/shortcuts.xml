<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_voice_record"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_voice_short"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.aistudio.neurosceibe.gktqwb"
            android:targetClass="com.example.MainActivity">
            <extra android:name="action_route" android:value="capture_voice" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="shortcut_camera_scan"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_camera_short"
        android:shortcutLongLabel="@string/shortcut_camera_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.aistudio.neurosceibe.gktqwb"
            android:targetClass="com.example.MainActivity">
            <extra android:name="action_route" android:value="capture_camera" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="shortcut_archive_lookup"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_archive_short"
        android:shortcutLongLabel="@string/shortcut_archive_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.aistudio.neurosceibe.gktqwb"
            android:targetClass="com.example.MainActivity">
            <extra android:name="action_route" android:value="open_archive" />
        </intent>
    </shortcut>
</shortcuts>
